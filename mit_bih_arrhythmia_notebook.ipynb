# Cell 17: Power consumption estimation
class PowerMonitor:
    """
    Estimates power consumption during training
    """
    def __init__(self):
        self.measurements = []
        self.start_time = None
        
    def start(self):
        self.start_time = time.time()
        self.initial_cpu = psutil.cpu_percent(interval=1)
        self.initial_memory = psutil.virtual_memory().percent
        
    def measure(self):
        if self.start_time:
            elapsed = time.time() - self.start_time
            cpu_usage = psutil.cpu_percent(interval=0.1)
            memory_usage = psutil.virtual_memory().percent
            
            # Estimate power (simplified model)
            # Base: 30W, CPU: +2W per 10%, Memory: +0.5W per 10%
            estimated_power = 30 + (cpu_usage/10)*2 + (memory_usage/10)*0.5
            
            self.measurements.append({
                'time': elapsed,
                'cpu': cpu_usage,
                'memory': memory_usage,
                'power_watts': estimated_power
            })
    
    def get_summary(self):
        if not self.measurements:
            return None
        
        avg_power = np.mean([m['power_watts'] for m in self.measurements])
        total_time = self.measurements[-1]['time'] if self.measurements else 0
        energy_joules = avg_power * total_time
        
        return {
            'avg_power_watts': avg_power,
            'total_time_seconds': total_time,
            'energy_joules': energy_joules,
            'energy_kwh': energy_joules / 3600000
        }
```

```python
# Cell 18: Comprehensive training function
def train_and_evaluate(model_fn, X_train, y_train, X_test, y_test, 
                       strategy_name, class_weights=None, epochs=50):
    """
    Trains model and evaluates with all metrics including power
    """
    print(f"\n{'='*60}")
    print(f"Training {strategy_name}")
    print(f"{'='*60}")
    
    # Initialize model and power monitor
    model = model_fn((X_train.shape[1],))
    power_monitor = PowerMonitor()
    
    # Callbacks
    early_stop = callbacks.EarlyStopping(
        monitor='val_loss', 
        patience=10, 
        restore_best_weights=True
    )
    
    reduce_lr = callbacks.ReduceLROnPlateau(
        monitor='val_loss',
        factor=0.5,
        patience=5,
        min_lr=1e-6
    )
    
    metrics_callback = ImbalancedMetricsCallback((X_test, y_test))
    
    # Start power monitoring
    power_monitor.start()
    
    # Training
    history = model.fit(
        X_train, y_train,
        validation_data=(X_test, y_test),
        epochs=epochs,
        batch_size=64,
        class_weight=class_weights,
        callbacks=[early_stop, reduce_lr, metrics_callback],
        verbose=1
    )
    
    # Measure power periodically during training
    for _ in range(10):
        power_monitor.measure()
        time.sleep(0.5)
    
    # Get power summary
    power_summary = power_monitor.get_summary()
    
    # Final evaluation
    y_pred = np.argmax(model.predict(X_test, verbose=0), axis=-1)
    
    # Calculate all metrics
    results = {
        'strategy': strategy_name,
        'accuracy': np.mean(y_pred == y_test),
        'sensitivity_per_class': sensitivity_per_class(y_test, y_pred),
        'f1_weighted': f1_score(y_test, y_pred, average='weighted'),
        'f1_macro': f1_score(y_test, y_pred, average='macro'),
        'parameters': model.count_params(),
        'power_consumption': power_summary,
        'confusion_matrix': confusion_matrix(y_test, y_pred)
    }
    
    return model, history, results
```

