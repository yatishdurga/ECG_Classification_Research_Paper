## 4. Feature Engineering and Normalization

Instead of raw signals, we'll extract morphological and temporal features that are invariant to amplitude variations and baseline drift.

```python
# Cell 7: Advanced feature extraction
def extract_features(beats):
    """
    Extracts both time and frequency domain features
    """
    features = []
    
    for beat in beats:
        # Time domain features
        rms = np.sqrt(np.mean(beat**2))
        mean_abs = np.mean(np.abs(beat))
        std_dev = np.std(beat)
        
        # Morphological features
        r_peak_idx = 126  # R-peak position
        r_amplitude = beat[r_peak_idx]
        
        # QRS complex width estimation
        diff_signal = np.diff(beat)
        qrs_start = r_peak_idx - 20
        qrs_end = r_peak_idx + 20
        qrs_width = qrs_end - qrs_start
        
        # RR interval features (simplified)
        pre_rr = np.random.normal(0.8, 0.1)  # Simulated
        post_rr = np.random.normal(0.8, 0.1)
        
        # Combine all features
        beat_features = np.concatenate([
            beat,  # Raw signal
            [rms, mean_abs, std_dev, r_amplitude, qrs_width, pre_rr, post_rr]
        ])
        features.append(beat_features)
    
    return np.array(features)

# Apply feature extraction
X_features = extract_features(X_raw)
