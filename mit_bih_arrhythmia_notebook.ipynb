# Cell 24: Real-time inference simulation
def simulate_real_time_deployment(model, X_test, batch_sizes=[1, 8, 32]):
    """
    Simulates real-time ECG monitoring scenario
    """
    print("\n🔬 REAL-TIME DEPLOYMENT SIMULATION")
    print("-"*50)
    
    for batch_size in batch_sizes:
        # Prepare batch
        test_batch = X_test[:batch_size]
        
        # Warmup
        for _ in range(10):
            _ = model.predict(test_batch, verbose=0)
        
        # Measure inference time
        times = []
        for _ in range(100):
            start = time.time()
            predictions = model.predict(test_batch, verbose=0)
            elapsed = time.time() - start
            times.append(elapsed)
        
        avg_time = np.mean(times) * 1000  # Convert to ms
        std_time = np.std(times) * 1000
        throughput = batch_size / (avg_time / 1000)  # Samples per second
        
        print(f"\nBatch Size: {batch_size}")
        print(f"  Inference Time: {avg_time:.2f} ± {std_time:.2f} ms")
        print(f"  Throughput: {throughput:.1f} samples/second")
        print(f"  Latency per sample: {avg_time/batch_size:.2f} ms")
        
        # Check if real-time capable (ECG at 360 Hz)
        if throughput >= 360:
            print(f"  ✓ Real-time capable for single-lead ECG")
        else:
            print(f"  ✗ Too slow for real-time (need 360 Hz)")

# Test with the most efficient model
