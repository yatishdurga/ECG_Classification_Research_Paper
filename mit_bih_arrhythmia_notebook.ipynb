## 5. Three Training Strategies

Now we implement our three approaches: (1) Direct training on imbalanced data, (2) SMOTE balancing, and (3) External augmentation.

```python
# Cell 9: Strategy 1 - Direct imbalanced training with class weights
def prepare_imbalanced_data(X, y, test_size=0.2):
    """
    Prepares imbalanced dataset with calculated class weights
    """
    # Encode labels
    label_map = {'N': 0, 'S': 1, 'V': 2, 'F': 3, 'Q': 4}
    y_encoded = np.array([label_map.get(label, 4) for label in y])
    
    # Split maintaining class proportions
    X_train, X_test, y_train, y_test = train_test_split(
        X, y_encoded, test_size=test_size, stratify=y_encoded, random_state=42
    )
    
    # Calculate class weights for handling imbalance
    class_counts = np.bincount(y_train)
    total_samples = len(y_train)
    n_classes = len(class_counts)
    
    class_weights = {}
    for i in range(n_classes):
        if class_counts[i] > 0:
            class_weights[i] = total_samples / (n_classes * class_counts[i])
        else:
            class_weights[i] = 1.0
    
    print("Class weights for imbalanced training:")
    for cls, weight in class_weights.items():
        print(f"  Class {cls}: {weight:.3f}")
    
    return X_train, X_test, y_train, y_test, class_weights

X_train_imb, X_test_imb, y_train_imb, y_test_imb, class_weights = prepare_imbalanced_data(
    X_normalized, y_raw
)
