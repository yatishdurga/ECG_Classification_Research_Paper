# Cell 22: Confusion matrix visualization
def plot_confusion_matrices(results_list, n_cols=3):
    """
    Displays confusion matrices for all models
    """
    n_results = len(results_list)
    n_rows = (n_results + n_cols - 1) // n_cols
    
    fig, axes = plt.subplots(n_rows, n_cols, figsize=(5*n_cols, 4*n_rows))
    axes = axes.flatten() if n_results > 1 else [axes]
    
    class_names = ['N', 'S', 'V', 'F', 'Q']
    
    for idx, result in enumerate(results_list):
        ax = axes[idx]
        cm = result['confusion_matrix']
        
        # Normalize confusion matrix
        cm_normalized = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]
        
        im = ax.imshow(cm_normalized, cmap='Blues', vmin=0, vmax=1)
        ax.set_title(result['strategy'], fontsize=10, fontweight='bold')
        ax.set_xlabel('Predicted', fontsize=9)
        ax.set_ylabel('Actual', fontsize=9)
        ax.set_xticks(range(len(class_names)))
        ax.set_yticks(range(len(class_names)))
        ax.set_xticklabels(class_names)
        ax.set_yticklabels(class_names)
        
        # Add text annotations
        for i in range(cm.shape[0]):
            for j in range(cm.shape[1]):
                text = ax.text(j, i, f'{cm[i, j]}\n({cm_normalized[i, j]:.2f})',
                             ha='center', va='center', fontsize=7,
                             color='white' if cm_normalized[i, j] > 0.5 else 'black')
    
    # Hide unused subplots
    for idx in range(n_results, len(axes)):
        axes[idx].axis('off')
    
    plt.tight_layout()
    plt.show()

