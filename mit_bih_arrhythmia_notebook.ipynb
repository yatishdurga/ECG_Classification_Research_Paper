```python
# Cell 13: Model Architecture 2 - Standard Deep CNN
def build_standard_cnn(input_shape, n_classes=5):
    """
    Standard deep CNN with residual connections
    """
    inputs = layers.Input(shape=input_shape)
    x = layers.Reshape((input_shape[0], 1))(inputs)
    
    # Block 1
    conv1 = layers.Conv1D(64, 5, activation='relu', padding='same')(x)
    conv1 = layers.BatchNormalization()(conv1)
    conv1 = layers.Conv1D(64, 5, activation='relu', padding='same')(conv1)
    conv1 = layers.BatchNormalization()(conv1)
    pool1 = layers.MaxPooling1D(2)(conv1)
    
    # Block 2
    conv2 = layers.Conv1D(128, 3, activation='relu', padding='same')(pool1)
    conv2 = layers.BatchNormalization()(conv2)
    conv2 = layers.Conv1D(128, 3, activation='relu', padding='same')(conv2)
    conv2 = layers.BatchNormalization()(conv2)
    pool2 = layers.MaxPooling1D(2)(conv2)
    
    # Block 3
    conv3 = layers.Conv1D(256, 3, activation='relu', padding='same')(pool2)
    conv3 = layers.BatchNormalization()(conv3)
    conv3 = layers.Dropout(0.3)(conv3)
    
    # Global pooling and dense
    gap = layers.GlobalAveragePooling1D()(conv3)
    dense1 = layers.Dense(128, activation='relu')(gap)
    dense1 = layers.Dropout(0.4)(dense1)
    outputs = layers.Dense(n_classes, activation='softmax')(dense1)
    
    model = models.Model(inputs, outputs)
    model.compile(
        optimizer=optimizers.Adam(learning_rate=0.0005),
        loss='sparse_categorical_crossentropy',
        metrics=['accuracy']
    )
    
    return model

standard_model = build_standard_cnn((X_train_imb.shape[1],))
standard_params = standard_model.count_params()
print(f"Standard CNN parameters: {standard_params:,}")
```

```python
# Cell 14: Model Architecture 3 - Advanced LSTM-CNN Hybrid
def build_lstm_cnn_hybrid(input_shape, n_classes=5):
    """
    Hybrid architecture combining CNN feature extraction with LSTM temporal modeling
    """
    inputs = layers.Input(shape=input_shape)
    x = layers.Reshape((input_shape[0], 1))(inputs)
    
    # CNN feature extraction
    cnn_features = layers.Conv1D(64, 7, activation='relu', padding='same')(x)
    cnn_features = layers.BatchNormalization()(cnn_features)
    cnn_features = layers.MaxPooling1D(2)(cnn_features)
    
    cnn_features = layers.Conv1D(128, 5, activation='relu', padding='same')(cnn_features)
    cnn_features = layers.BatchNormalization()(cnn_features)
    cnn_features = layers.MaxPooling1D(2)(cnn_features)
    
    # Bidirectional LSTM for temporal dependencies
    lstm_out = layers.Bidirectional(layers.LSTM(64, return_sequences=True))(cnn_features)
    lstm_out = layers.Bidirectional(layers.LSTM(32))(lstm_out)
    
    # Dense layers
    dense = layers.Dense(128, activation='relu')(lstm_out)
    dense = layers.Dropout(0.4)(dense)
    dense = layers.Dense(64, activation='relu')(dense)
    dense = layers.Dropout(0.3)(dense)
    outputs = layers.Dense(n_classes, activation='softmax')(dense)
    
    model = models.Model(inputs, outputs)
    model.compile(
        optimizer=optimizers.Adam(learning_rate=0.0003),
        loss='sparse_categorical_crossentropy',
        metrics=['accuracy']
    )
    
    return model

hybrid_model = build_lstm_cnn_hybrid((X_train_imb.shape[1],))
hybrid_params = hybrid_model.count_params()
print(f"Hybrid LSTM-CNN parameters: {hybrid_params:,}")
```

## 7. Hyperparameter Optimization for Imbalanced Learning

Key insight: Traditional hyperparameters fail on imbalanced data. We need to optimize specifically for minority class performance.

```python
# Cell 15: Custom metrics for imbalanced learning
def sensitivity_per_class(y_true, y_pred):
    """
    Calculates sensitivity (recall) for each class
    """
    sensitivities = []
    for cls in np.unique(y_true):
        mask = y_true == cls
        if np.sum(mask) > 0:
            correct = np.sum((y_pred[mask] == cls))
            total = np.sum(mask)
            sensitivities.append(correct / total)
    return sensitivities

class ImbalancedMetricsCallback(callbacks.Callback):
    """
    Custom callback to track minority class performance
    """
    def __init__(self, validation_data):
        super().__init__()
        self.validation_data = validation_data
        self.history = {'sensitivity': [], 'minority_f1': []}
    
    def on_epoch_end(self, epoch, logs=None):
        X_val, y_val = self.validation_data
        y_pred = np.argmax(self.model.predict(X_val, verbose=0), axis=-1)
        
        # Calculate per-class sensitivity
        sensitivities = sensitivity_per_class(y_val, y_pred)
        
        # F1 score for minority classes
        f1_scores = []
        for cls in np.unique(y_val):
            if np.sum(y_val == cls) < len(y_val) * 0.2:  # Minority class
                mask = (y_val == cls) | (y_pred == cls)
                if np.sum(mask) > 0:
                    f1 = f1_score(y_val[mask] == cls, y_pred[mask] == cls, average='binary')
                    f1_scores.append(f1)
        
        avg_sensitivity = np.mean(sensitivities)
        avg_minority_f1 = np.mean(f1_scores) if f1_scores else 0
        
        self.history['sensitivity'].append(avg_sensitivity)
        self.history['minority_f1'].append(avg_minority_f1)
        
        print(f"\nEpoch {epoch+1} - Avg Sensitivity: {avg_sensitivity:.4f}, "
              f"Minority F1: {avg_minority_f1:.4f}")
```

```python
# Cell 16: Hyperparameter search for imbalanced data
def optimize_for_imbalance(model_fn, X_train, y_train, X_val, y_val, class_weights):
    """
    Grid search optimizing for balanced accuracy
    """
    hyperparams = {
        'learning_rate': [0.001, 0.0005, 0.0001],
        'batch_size': [32, 64, 128],
        'focal_loss_gamma': [0, 1, 2],  # For focal loss
    }
    
    best_score = 0
    best_params = {}
    
    for lr in hyperparams['learning_rate']:
        for batch_size in hyperparams['batch_size']:
            for gamma in hyperparams['focal_loss_gamma']:
                print(f"\nTesting LR={lr}, Batch={batch_size}, Gamma={gamma}")
                
                # Build model with current hyperparameters
                model = model_fn((X_train.shape[1],))
                
                # Compile with focal loss if gamma > 0
                if gamma > 0:
                    # Implement focal loss
                    def focal_loss(y_true, y_pred):
                        epsilon = tf.keras.backend.epsilon()
                        y_pred = tf.clip_by_value(y_pred, epsilon, 1. - epsilon)
                        p_t = tf.where(tf.equal(y_true, 1), y_pred, 1 - y_pred)
                        alpha_factor = tf.ones_like(y_true) * 0.25
                        focal_weight = alpha_factor * tf.pow((1 - p_t), gamma)
                        cross_entropy = -tf.math.log(p_t)
                        loss = focal_weight * cross_entropy
                        return tf.reduce_mean(loss)
                    
                    model.compile(
                        optimizer=optimizers.Adam(learning_rate=lr),
                        loss=focal_loss,
                        metrics=['accuracy']
                    )
                else:
                    model.compile(
                        optimizer=optimizers.Adam(learning_rate=lr),
                        loss='sparse_categorical_crossentropy',
                        metrics=['accuracy']
                    )
                
                # Train for few epochs
                history = model.fit(
                    X_train, y_train,
                    validation_data=(X_val, y_val),
                    epochs=10,
                    batch_size=batch_size,
                    class_weight=class_weights,
                    verbose=0
                )
                
                # Evaluate on validation set
                y_pred = np.argmax(model.predict(X_val, verbose=0), axis=-1)
                sensitivities = sensitivity_per_class(y_val, y_pred)
                balanced_accuracy = np.mean(sensitivities)
                
                if balanced_accuracy > best_score:
                    best_score = balanced_accuracy
                    best_params = {'lr': lr, 'batch_size': batch_size, 'gamma': gamma}
                
                print(f"Balanced Accuracy: {balanced_accuracy:.4f}")
    
    print(f"\nBest parameters: {best_params}")
    print(f"Best balanced accuracy: {best_score:.4f}")
    
    return best_params

# Split validation set for hyperparameter tuning
X_train_split, X_val_split, y_train_split, y_val_split = train_test_split(
    X_train_imb, y_train_imb, test_size=0.15, stratify=y_train_imb, random_state=42
)

best_hyperparams = optimize_for_imbalance(
    build_standard_cnn, X_train_split, y_train_split, 
    X_val_split, y_val_split, class_weights
)
