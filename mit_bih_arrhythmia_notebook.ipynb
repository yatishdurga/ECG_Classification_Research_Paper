```python
# Cell 11: Strategy 3 - External augmentation (simulated)
def augment_with_external_data(X_train, y_train):
    """
    Simulates augmentation with external abnormal beats
    """
    print("Augmenting with external data...")
    
    # Identify minority classes
    class_counts = Counter(y_train)
    majority_class = max(class_counts, key=class_counts.get)
    majority_count = class_counts[majority_class]
    
    augmented_X = [X_train]
    augmented_y = [y_train]
    
    # For each minority class, add synthetic "external" samples
    for cls in class_counts:
        if cls != majority_class:
            deficit = majority_count - class_counts[cls]
            if deficit > 0:
                # Get existing samples of this class
                cls_samples = X_train[y_train == cls]
                
                # Create variations (simulating external data)
                n_augment = min(deficit, len(cls_samples) * 2)
                indices = np.random.choice(len(cls_samples), n_augment, replace=True)
                augmented_samples = cls_samples[indices]
                
                # Add noise to simulate different patients
                noise = np.random.normal(0, 0.05, augmented_samples.shape)
                augmented_samples = augmented_samples + noise
                
                augmented_X.append(augmented_samples)
                augmented_y.append(np.full(n_augment, cls))
    
    X_augmented = np.vstack(augmented_X)
    y_augmented = np.hstack(augmented_y)
    
    print(f"After augmentation: {Counter(y_augmented)}")
    
    return X_augmented, y_augmented

X_train_aug, y_train_aug = augment_with_external_data(X_train_imb, y_train_imb)
