```python
# Cell 8: Patient-specific normalization
def normalize_per_patient(X, y, patient_ids=None):
    """
    Z-score normalization maintaining patient grouping
    """
    # If no patient IDs provided, use random assignment for demo
    if patient_ids is None:
        n_patients = 44
        samples_per_patient = len(X) // n_patients
        patient_ids = np.repeat(np.arange(n_patients), samples_per_patient)
        if len(patient_ids) < len(X):
            patient_ids = np.concatenate([patient_ids, 
                                         np.full(len(X) - len(patient_ids), n_patients-1)])
    
    X_normalized = np.zeros_like(X)
    
    for pid in np.unique(patient_ids):
        mask = patient_ids == pid
        scaler = StandardScaler()
        X_normalized[mask] = scaler.fit_transform(X[mask])
    
    return X_normalized

X_normalized = normalize_per_patient(X_features, y_raw)
