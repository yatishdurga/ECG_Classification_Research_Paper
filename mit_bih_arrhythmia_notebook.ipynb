# Cell 21: Statistical significance testing
from scipy import stats

def statistical_comparison(results_list):
    """
    Performs statistical tests to validate findings
    """
    print("Statistical Analysis of Results")
    print("="*60)
    
    # Group results by strategy
    imbalanced_results = [r for r in results_list if 'Imbalanced' in r['strategy']]
    smote_results = [r for r in results_list if 'SMOTE' in r['strategy']]
    augmented_results = [r for r in results_list if 'Augmented' in r['strategy']]
    
    # Compare accuracies
    if len(imbalanced_results) > 1 and len(smote_results) > 1:
        imb_acc = [r['accuracy'] for r in imbalanced_results]
        smote_acc = [r['accuracy'] for r in smote_results]
        
        t_stat, p_value = stats.ttest_ind(imb_acc, smote_acc)
        print(f"\nImbalanced vs SMOTE accuracy:")
        print(f"  Imbalanced mean: {np.mean(imb_acc):.4f} ± {np.std(imb_acc):.4f}")
        print(f"  SMOTE mean: {np.mean(smote_acc):.4f} ± {np.std(smote_acc):.4f}")
        print(f"  t-statistic: {t_stat:.4f}, p-value: {p_value:.4f}")
        
        if p_value < 0.05:
            print("  Result: Statistically significant difference")
        else:
            print("  Result: No significant difference")
    
    # Compare F1 scores
    print("\nF1 Macro Score Comparison:")
    for result in results_list:
        print(f"  {result['strategy']}: {result['f1_macro']:.4f}")
    
    # Efficiency analysis
    print("\nEfficiency Analysis (Accuracy per Watt):")
    for result in results_list:
        efficiency = result['accuracy'] / result['power_consumption']['avg_power_watts']
        print(f"  {result['strategy']}: {efficiency:.6f}")

statistical_comparison(all_results)
