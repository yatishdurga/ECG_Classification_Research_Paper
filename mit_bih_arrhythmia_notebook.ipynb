# Cell 10: Strategy 2 - SMOTE balancing
def apply_smote_balancing(X_train, y_train):
    """
    Applies SMOTE to balance the training set
    """
    print("Applying SMOTE...")
    print(f"Before SMOTE: {Counter(y_train)}")
    
