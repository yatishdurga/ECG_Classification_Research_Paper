# Cell 6: Visualize class imbalance
def plot_class_distribution(labels, title="Class Distribution"):
    """
    Creates publication-quality imbalance visualization
    """
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))
    
    # Count occurrences
    unique, counts = np.unique(labels, return_counts=True)
    total = len(labels)
    
    # Bar plot
    colors = ['#2E7D32', '#1565C0', '#C62828', '#F57C00', '#6A1B9A']
    bars = ax1.bar(unique, counts, color=colors[:len(unique)], edgecolor='black', linewidth=1.5)
    ax1.set_xlabel('AAMI Class', fontsize=12)
    ax1.set_ylabel('Number of Samples', fontsize=12)
    ax1.set_title(title, fontsize=14, fontweight='bold')
    
    # Add percentage labels
    for bar, count in zip(bars, counts):
        height = bar.get_height()
        ax1.text(bar.get_x() + bar.get_width()/2., height,
                f'{count}\n({100*count/total:.1f}%)',
                ha='center', va='bottom', fontsize=10)
    
    # Pie chart for proportions
    ax2.pie(counts, labels=unique, colors=colors[:len(unique)], 
            autopct='%1.1f%%', startangle=90, wedgeprops={'edgecolor': 'black'})
    ax2.set_title('Proportion of Classes', fontsize=14, fontweight='bold')
    
    plt.tight_layout()
    plt.show()
    
    # Calculate imbalance ratio
    imbalance_ratio = max(counts) / min(counts)
    print(f"Imbalance Ratio (max/min): {imbalance_ratio:.2f}")
    print(f"Minority class has {min(counts)} samples ({100*min(counts)/total:.2f}%)")

